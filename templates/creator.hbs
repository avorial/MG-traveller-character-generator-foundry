<section class="traveller-creator">
  <header class="tc-header">
    <div>
      <h2>{{character.name}}</h2>
      <p>Phase: {{character.phase}} | Age {{character.age}} | {{character.species_id}}</p>
    </div>
    <div class="tc-header-actions">
      <button type="button" data-action="reset"><i class="fa-solid fa-rotate-left"></i> Reset</button>
      {{#if canCreate}}
        <button type="button" class="primary" data-action="createActor"><i class="fa-solid fa-user-plus"></i> Create Actor</button>
      {{/if}}
    </div>
  </header>

  <div class="tc-grid">
    <aside class="tc-sheet">
      <label>
        Name
        <input name="name" type="text" value="{{character.name}}" placeholder="Unnamed Traveller">
      </label>

      <div class="tc-stats">
        {{#each stats as |entry|}}
          <div class="tc-stat">
            <span>{{entry.[0]}}</span>
            <strong>{{entry.[1]}}</strong>
          </div>
        {{/each}}
      </div>

      <h3>Skills</h3>
      <ol class="tc-list">
        {{#each character.skills as |skill|}}
          <li>{{skill.name}}{{#if skill.speciality}} ({{skill.speciality}}){{/if}} {{skill.level}}</li>
        {{/each}}
      </ol>

      <h3>Recent Log</h3>
      <ol class="tc-list">
        {{#each notes as |note|}}
          <li>{{note}}</li>
        {{/each}}
      </ol>
    </aside>

    <main class="tc-stage">
      {{#if (eq character.phase "characteristics")}}
        <h3>Roll Characteristics</h3>
        <p>Roll STR, DEX, END, INT, EDU, and SOC. Heroic and GM-forced variants are implemented in the engine API and can be wired into this screen as parity work continues.</p>
        <button type="button" class="primary" data-action="roll">Roll 2D x 6</button>
      {{/if}}

      {{#if (eq character.phase "society")}}
        <h3>Society Of Origin</h3>
        <div class="tc-card-grid">
          {{#each societies as |society|}}
            <button type="button" data-action="chooseSociety" data-id="{{society.id}}">
              <strong>{{society.name}}</strong>
            </button>
          {{/each}}
        </div>
      {{/if}}

      {{#if (eq character.phase "species")}}
        <h3>Species</h3>
        <div class="tc-card-grid">
          {{#each species as |sp|}}
            <button type="button" data-action="applySpecies" data-id="{{sp.id}}">
              <strong>{{sp.name}}</strong>
            </button>
          {{/each}}
        </div>
      {{/if}}

      {{#if (eq character.phase "background")}}
        <h3>Background</h3>
        <div class="tc-actions">
          <button type="button" data-action="skipBackground"><i class="fa-solid fa-graduation-cap"></i> Pre-Career Education</button>
          <button type="button" data-action="skipPreCareer"><i class="fa-solid fa-briefcase"></i> Skip To Career</button>
        </div>

        {{#if needsDroyneCaste}}
          <h4>Droyne Casting</h4>
          <div class="tc-card-grid compact">
            <button type="button" data-action="rollDroyneCaste"><strong>Roll Caste</strong></button>
            <button type="button" data-action="rollDroyneCaste" data-caste="worker"><strong>Worker</strong></button>
            <button type="button" data-action="rollDroyneCaste" data-caste="warrior"><strong>Warrior</strong></button>
            <button type="button" data-action="rollDroyneCaste" data-caste="drone"><strong>Drone</strong></button>
            <button type="button" data-action="rollDroyneCaste" data-caste="technician"><strong>Technician</strong></button>
            <button type="button" data-action="rollDroyneCaste" data-caste="sport"><strong>Sport</strong></button>
            <button type="button" data-action="rollDroyneCaste" data-caste="leader"><strong>Leader</strong></button>
          </div>
        {{/if}}

        {{#if isKkree}}
          <h4>K'kree Family</h4>
          <button type="button" data-action="setupKkreeFamily"><i class="fa-solid fa-users"></i> Confirm Family</button>
        {{/if}}

        <h4>Manual Background Skills</h4>
        <div class="tc-card-grid compact">
          <button type="button" data-action="applyManualBackground" data-skills="Admin,Streetwise,Vacc Suit"><strong>Urban</strong></button>
          <button type="button" data-action="applyManualBackground" data-skills="Survival,Recon,Animals"><strong>Frontier</strong></button>
          <button type="button" data-action="applyManualBackground" data-skills="Mechanic,Electronics,Profession"><strong>Technical</strong></button>
          <button type="button" data-action="applyManualBackground" data-skills="Carouse,Language,Admin"><strong>Cosmopolitan</strong></button>
        </div>

        <h4>Background Package</h4>
        <div class="tc-card-grid">
          {{#each backgroundPackages as |pkg|}}
            <button type="button" data-action="applyBackgroundPackage" data-id="{{pkg.id}}">
              <strong>{{pkg.name}}</strong>
            </button>
          {{/each}}
        </div>
      {{/if}}

      {{#if (eq character.phase "aslan_setup")}}
        <h3>Aslan Setup</h3>
        {{#if (eq aslanPhase "gender")}}
          <div class="tc-card-grid compact">
            <button type="button" data-action="chooseAslanGender" data-gender="male"><strong>Male</strong></button>
            <button type="button" data-action="chooseAslanGender" data-gender="female"><strong>Female</strong></button>
          </div>
        {{/if}}
        {{#if (eq aslanPhase "clan")}}
          <button type="button" class="primary" data-action="rollAslanClan">Roll Clan</button>
        {{/if}}
        {{#if (eq aslanPhase "ancestry")}}
          <button type="button" class="primary" data-action="rollAslanAncestry">Roll Ancestry</button>
        {{/if}}
        {{#if (eq aslanPhase "family")}}
          <button type="button" class="primary" data-action="rollAslanFamily">Roll Family</button>
        {{/if}}
        {{#if (eq aslanPhase "rite")}}
          <button type="button" class="primary" data-action="rollAslanRite">Roll Rite Of Passage</button>
        {{/if}}
      {{/if}}

      {{#if (eq character.phase "zhodani_training")}}
        <h3>Psionic Training</h3>
        <button type="button" class="primary" data-action="finishZhodaniTraining">Continue</button>
      {{/if}}

      {{#if (eq character.phase "pre_career")}}
        <h3>Pre-Career Education</h3>
        {{#if character.pre_career_status.enrolled}}
          <div class="tc-actions">
            <button type="button" data-action="preCareerEvent"><i class="fa-solid fa-dice"></i> Roll Event</button>
            <button type="button" class="primary" data-action="graduatePreCareer"><i class="fa-solid fa-graduation-cap"></i> Graduate</button>
            <button type="button" data-action="skipPreCareer"><i class="fa-solid fa-briefcase"></i> Leave Education</button>
          </div>
        {{else}}
          <div class="tc-actions">
            <button type="button" data-action="skipPreCareer"><i class="fa-solid fa-briefcase"></i> Skip To Career</button>
          </div>
          <div class="tc-card-grid">
            {{#each educationTracks as |track|}}
              {{#each track.servicesList as |service|}}
                <button type="button" data-action="qualifyPreCareer" data-id="{{track.id}}" data-service="{{service.id}}">
                  <strong>{{service.name}}</strong>
                </button>
              {{else}}
                {{#each track.curriculaList as |curriculum|}}
                  <button type="button" data-action="qualifyPreCareer" data-id="{{track.id}}" data-curriculum="{{curriculum.id}}">
                    <strong>{{track.name}}: {{curriculum.name}}</strong>
                  </button>
                {{else}}
                  <button type="button" data-action="qualifyPreCareer" data-id="{{track.id}}">
                    <strong>{{track.name}}</strong>
                  </button>
                {{/each}}
              {{/each}}
            {{/each}}
          </div>
        {{/if}}
      {{/if}}

      {{#if (eq character.phase "career")}}
        <h3>Career Package</h3>
        <p>Career packages are implemented as a data-driven fast path while the full term-by-term career loop is being ported.</p>
        <div class="tc-card-grid">
          {{#each careerPackages as |pkg|}}
            <button type="button" data-action="applyCareerPackage" data-id="{{pkg.id}}">
              <strong>{{pkg.name}}</strong>
            </button>
          {{/each}}
        </div>
      {{/if}}

      {{#if (eq character.phase "skill_package")}}
        <h3>Final Skill Package</h3>
        <div class="tc-card-grid">
          {{#each skillPackages as |pkg|}}
            <button type="button" data-action="applySkillPackage" data-id="{{pkg.id}}">
              <strong>{{pkg.name}}</strong>
            </button>
          {{/each}}
        </div>
      {{/if}}

      {{#if (eq character.phase "done")}}
        <h3>Ready For Foundry</h3>
        <p>This Traveller can now be created as a native `mgt2e` actor with term, item, skill, finance, and sophont data.</p>
        <button type="button" class="primary" data-action="createActor"><i class="fa-solid fa-user-plus"></i> Create Actor</button>
      {{/if}}
    </main>
  </div>
</section>
